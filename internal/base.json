{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/UTC",
  "configMigration": true,
  "osvVulnerabilityAlerts": true,
  "branchNameStrict": true,
  "rollbackPrs": true,
  "branchTopic": "{{#if isLockfileUpdate}}lockfile{{else}}update{{/if}}/{{{datasource}}}/{{{depNameSanitized}}}/{{{newVersion}}}",
  "fetchChangeLogs": "branch",
  "extends": [
    "config:base",
    ":widenPeerDependencies",
    ":rebaseStalePrs",
    "helpers:pinGitHubActionDigests",
    "helpers:pinGitHubActionDigestsToSemver",
    "github>wyrihaximus/renovate-config//internal/labels"
  ],
  "packageRules": [
    {
      "extends": [
        "github>wyrihaximus/renovate-config//internal/do-not-update-tool-constraints"
      ]
    }
  ]
}
